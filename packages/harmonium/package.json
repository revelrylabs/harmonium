{
  "name": "harmonium",
  "version": "9.0.0-alpha.3",
  "description": "Ship products, not utility classes. A complete React design system out of the box.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/revelrylabs/harmonium.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css",
    "./styles.layer.css": "./dist/index.layer.css",
    "./tokens.css": "./dist/tokens.css",
    "./harmonium.css": "./dist/harmonium.css",
    "./package.json": "./package.json",
    "./*": {
      "import": {
        "types": "./dist/components/*.d.ts",
        "default": "./dist/components/*.js"
      },
      "require": {
        "types": "./dist/components/*.d.cts",
        "default": "./dist/components/*.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "dist/*": [
        "./dist/*"
      ],
      "*": [
        "./dist/components/*.d.ts"
      ]
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "CLAUDE.md",
    "AGENTS.md",
    "llms.txt",
    "llms-full.txt",
    "components.json"
  ],
  "scripts": {
    "build": "pnpm run tokens && tsup && node --import tsx scripts/add-use-client.ts && cp src/tokens/tokens.css dist/tokens.css && node --import tsx scripts/build-css.ts && node --import tsx scripts/build-global-css.ts && node --import tsx scripts/check-dist.ts",
    "tokens": "node --import tsx ./src/tokens/build.ts",
    "size": "node --import tsx scripts/check-size.ts",
    "size:competitors": "node --import tsx scripts/measure-competitors.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "clean": "rm -rf dist/",
    "prepack": "cp ../../README.md ../../llms.txt ../../llms-full.txt .",
    "docs:llms": "node --import tsx scripts/generate-llm-docs.ts"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "0.27.3",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "style-dictionary": "^4.3.0",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.1.0",
    "vitest-axe": "^0.1.0"
  }
}
